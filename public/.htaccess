# ==============================================================================
# Jurnal Permukiman - Public Uploads Directory Hardening
# Prevents execution of scripts uploaded via OJS file managers or submission forms
# ==============================================================================

# Disable execution of scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|bash)$">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -ExecCGI -Indexes
