# ==============================================================================
# Jurnal Permukiman - BSSN & SPBE Security Hardening Configuration
# Baseline: BSSN Panduan Pengamanan Web & SINTA-2 Enterprise Standards
# ==============================================================================

# 1. Disable Directory Listing
Options -Indexes

# 2. Block direct access to configuration and sensitive files
<Files "config.inc.php">
    Order allow,deny
    Deny from all
</Files>

<FilesMatch "\.(sql|bak|old|orig|backup|log|ini|env|sh|md|git|yml|yaml|dist|zip|tar|gz|rar|7z)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Security Headers (BSSN / SPBE Compliance)
<IfModule mod_headers.c>
    # Remove PHP version leakage
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    # Legacy XSS filter protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer policy for privacy & security
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Restrict unnecessary browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Content Security Policy (BSSN & OWASP Top 10 Compliance)
    Header always set Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://jurnalpermukiman.pu.go.id https://s01.flagcounter.com https://c.statcounter.com; connect-src 'self'; frame-src 'self' blob: data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';"
</IfModule>
